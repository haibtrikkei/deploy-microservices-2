# ========================================================
# CẤU HÌNH IMAGE REGISTRY (GHCR) & TAG
# ========================================================
# Tiền tố image trên GitHub Container Registry (ghcr.io/<github-username-in-lowercase>)
# Ví dụ: ghcr.io/haibtrikkei
IMAGE_PREFIX=ghcr.io/haibtrikkei

# Tag phiên bản image cần chạy (mặc định: latest)
IMAGE_TAG=latest
